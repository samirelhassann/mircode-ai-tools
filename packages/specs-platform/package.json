{
  "name": "@mir-code/specs-platform",
  "version": "0.0.0-development",
  "description": "Specs Platform — documentação de specs/features, discoveries e drawings com UI local e disparo de agents (Claude Code / Cursor).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "specs": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "assets", "scripts"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ./scripts/copy-ui.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "postinstall": "node ./scripts/fix-node-pty-perms.cjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "commander": "^12.1.0",
    "fastify": "^5.1.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.0.9",
    "node-pty": "^1.0.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mir-code/specs-server": "workspace:*",
    "@mir-code/specs-ui": "workspace:*",
    "@mir-code/toolkit-core": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
